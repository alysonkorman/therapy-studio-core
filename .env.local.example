# Non-secret frontend configuration for a NON-PHI AWS development environment only.
# Do not commit a real .env.local file.
VITE_LIVE_SESSION_ORIGIN=https://replace-with-http-api-id.execute-api.us-east-1.amazonaws.com
VITE_LIVE_SESSION_WS_ORIGIN=wss://replace-with-websocket-api-id.execute-api.us-east-1.amazonaws.com/dev
# Use the exact Cognito authorize URL generated from stack outputs. This app captures
# the returned id_token in the fragment and removes it from the visible URL.
VITE_COGNITO_LOGIN_URL=https://replace-with-domain.auth.us-east-1.amazoncognito.com/login?client_id=replace-with-client-id&response_type=token&scope=openid+email&redirect_uri=http%3A%2F%2F127.0.0.1%3A5173
